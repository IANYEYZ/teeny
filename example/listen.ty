count = 0
page = () => "
<!doctype html>
<html>
  <body>
    <h1>Counter: <span id='count'>{count}</span></h1>
    <button onclick='inc()'>+1</button>

    <script>
      async function inc() \{
        const res = await fetch('/inc', \{ method: 'POST' \})
        const data = await res.json()
        document.getElementById('count').textContent = data.count
      \}
    </script>
  </body>
</html>
"
http.listen(3030, (req) => {
  match [req.method, req.path] {
    ["GET", "/"]:
      [headers: ["content-type": "text/html"], body: page()],

    ["POST", "/inc"]:
      {
        count += 1;
        [json: [count: count]]
      },

    _:
      [status: 404, body: "not found"]
  }
})